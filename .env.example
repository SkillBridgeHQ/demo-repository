# SkillBridge Waitlist Backend
# Development template only. Never use these placeholder values in production.

APP_NAME="SkillBridge Waitlist API"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL: replace placeholders with your own local/development connection.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local frontend origins.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Generate a new Base64-encoded 32-byte key for each environment.
# Never reuse the example text as an encryption key.
ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
ENCRYPTION_KEY_V2=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
ENCRYPTION_ACTIVE_KEY_VERSION=v1

# Local development: trust only loopback.
# Production proxy configuration must be separately verified.
TRUSTED_PROXY_CIDRS='["127.0.0.1/32"]'

# Local Redis.
REDIS_URL=redis://127.0.0.1:6379/0

# Local development does not deliver real emails.
EMAIL_MODE=console
# Gmail SMTP (select EMAIL_MODE=smtp only after credentials are configured).
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_FRONTEND_URL=http://localhost:3000

# Waitlist capacity and consent.
EARLY_ACCESS_CAP=500
CONSENT_VERSION=development-test-only-v1

# Verification and deletion token lifetimes.
VERIFICATION_TOKEN_TTL_MINUTES=1440
DELETION_TOKEN_TTL_MINUTES=60

# Email outbox worker.
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_LEASE_SECONDS=1800
OUTBOX_MAX_RETRIES=5
OUTBOX_BACKOFF_BASE_SECONDS=60

# Distributed rate limits.
REGISTRATION_RATE_LIMIT=5
VERIFICATION_RATE_LIMIT=10
RESEND_RATE_LIMIT=3
RESEND_EMAIL_COOLDOWN_SECONDS=300
DELETION_RATE_LIMIT=3
